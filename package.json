{
  "name": "relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "db:migrate": "tsx docker/db/run-migrations.ts",
    "db:seed": "tsx docker/db/seed.ts",
    "seed": "npm run db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie": "^2.0.1",
    "express": "^5.2.1",
    "jose": "^6.2.10",
    "mongoose": "^9.9.3",
    "mysql2": "^3.11.3",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.5.12",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.67.0"
  }
}
